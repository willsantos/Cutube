<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0" />
      <PackageReference Include="YoutubeDLSharp" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- Incluir yt-dlp bundleado no build e publish -->
      <None Include="bin\yt-dlp">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>true</Pack>
        <PackagePath>bin\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.github\.gitkeep">
        <Link>.github\.gitkeep</Link>
      </Content>
      <Content Include="..\.github\ISSUE_TEMPLATE\bug_report.md">
        <Link>.github\ISSUE_TEMPLATE\bug_report.md</Link>
      </Content>
      <Content Include="..\.github\ISSUE_TEMPLATE\feature_request.md">
        <Link>.github\ISSUE_TEMPLATE\feature_request.md</Link>
      </Content>
      <Content Include="..\.github\pull_request_template.md">
        <Link>.github\pull_request_template.md</Link>
      </Content>
      <Content Include="..\.github\workflows\tags.yml">
        <Link>.github\workflows\tags.yml</Link>
      </Content>
      <Content Include="..\Assets\image.png">
        <Link>Assets\image.png</Link>
      </Content>
      <Content Include="..\README.md">
        <Link>README.md</Link>
      </Content>
    </ItemGroup>

</Project>
