# Cutube Environment Configuration

# RabbitMQ
RABBITMQ_USER=cutube
RABBITMQ_PASS=your-secure-password-here

# API
ASPNETCORE_ENVIRONMENT=Production

# Worker
DOTNET_ENVIRONMENT=Production
WORKER_REPLICAS=2
MAX_CONCURRENT=3

# Web
NODE_ENV=production
API_INTERNAL_URL=http://api:8080
# Optional browser override when running web outside Docker
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/downloads
