{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".github/skills/impeccable/scripts/impeccable\" ] || \".github/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".github/skills/impeccable/scripts/impeccable.cmd\" (\".github/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".github/skills/impeccable/scripts/impeccable\" ] || \".github/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".github/skills/impeccable/scripts/impeccable.cmd\" (\".github/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
